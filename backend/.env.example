# Serveur
PORT=3000
NODE_ENV=development

# Base de données (PostgreSQL)
# En local avec un Postgres classique : DATABASE_URL et DIRECT_URL peuvent être identiques.
# Avec Neon : DATABASE_URL = connexion "pooled" (hôte contenant "-pooler"),
#             DIRECT_URL   = connexion directe (sans "-pooler"), utilisée par Prisma pour les migrations.
# Astuce : créer une "branche" Neon dédiée au développement et aux tests pour ne jamais
# utiliser la base de production en local.
DATABASE_URL="postgresql://chatb2b:chatb2b@localhost:5432/chatb2b?schema=public"
DIRECT_URL="postgresql://chatb2b:chatb2b@localhost:5432/chatb2b?schema=public"

# JWT
JWT_SECRET=change_moi_en_production
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173